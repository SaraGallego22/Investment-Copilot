# ─────────────────────────────────────────────────────────────
# Google Cloud
# ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=agentic-507018
GOOGLE_GENAI_USE_VERTEXAI=true

# IMPORTANT: must be "global", not a regional endpoint.
# Verified 2026-08-29: Gemini 3.5 models return 404 in us-central1,
# us-east5, europe-west4, us-west1 and asia-northeast1. They are only
# served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global

# Where the CONTAINERS run. Separate from the model endpoint above:
# "global" is a valid Vertex endpoint but NOT a valid Cloud Run region.
CLOUD_RUN_REGION=us-central1

# Only needed if using AI Studio instead of Vertex.
# With Vertex + `gcloud auth application-default login`, leave this empty.
GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Models — verified live against this project on 2026-08-29
# The contest mandates Gemini 3.5 or newer. Do not downgrade these.
# ─────────────────────────────────────────────────────────────
MODEL_DEFAULT=gemini-3.5-flash

# NOTE: no Pro-class 3.5 model is available on this project (every
# gemini-3.5-pro* variant 404s in every region tested). The reflection
# step therefore uses the SAME model with a raised thinking budget
# instead of switching model family. gemini-2.5-pro exists but is NOT
# rules-compliant.
MODEL_COMPLEX_REASONING=gemini-3.5-flash
REFLECTION_THINKING_BUDGET=8192

# gemini-embedding-001 → 3072 dims (verified)
# text-multilingual-embedding-002 → 768 dims (verified; smaller index,
#   explicitly multilingual — the fallback if ES→EN retrieval disappoints)
EMBEDDING_MODEL=gemini-embedding-001

# ─────────────────────────────────────────────────────────────
# Memory
# ─────────────────────────────────────────────────────────────
MEMORY_BACKEND=json
MEMORY_PATH=data/memory
FIRESTORE_COLLECTION_USER_PROFILES=user_profiles

# ─────────────────────────────────────────────────────────────
# RAG
# ─────────────────────────────────────────────────────────────
RAG_CORPUS_PATH=data/corpus
RAG_INDEX_PATH=data/index/corpus_index.json
RAG_TOP_K=3

# ─────────────────────────────────────────────────────────────
# Market Simulator API
# ─────────────────────────────────────────────────────────────
MARKET_API_URL=http://localhost:8081
MARKET_API_KEY=change-me-local-dev
